# Публичный URL сайта (без слэша в конце).
# На Vercel: Project → Settings → Environment Variables
NEXT_PUBLIC_SITE_URL=https://alastaucleaning.vercel.app

# Google Analytics 4 — Measurement ID вида G-XXXXXXXXXX
# Без этой переменной скрипт GA не подключается
NEXT_PUBLIC_GA_ID=

# Яндекс.Метрика — числовой ID счётчика
# Без этой переменной скрипт Метрики не подключается
# В кабинете Метрики создайте цели JavaScript-событие с именами:
# whatsapp_click, phone_click, calc_start, calc_extras_add, alastau_toggle, booking_submit
NEXT_PUBLIC_YM_ID=

# Firebase (веб-конфиг из Console → Project settings → Your apps)
# Ключи NEXT_PUBLIC_* попадают в браузер — это нормально для Firebase Web SDK.
# Обязательно настройте Firestore Security Rules (см. docs/firebase-setup.md).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Telegram-бот: уведомление о новой заявке (серверные, без NEXT_PUBLIC_)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
